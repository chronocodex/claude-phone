# Copy this file to .env and fill in real values.
# NEVER commit .env - it's already in .gitignore.

# ---------- Required for Tier 1 (core conversation) ----------
ANTHROPIC_API_KEY=

# ---------- Tier 3: Alerting ----------
# Only needed if you've filled in `ami.host` in config.yaml.
# AMI_SECRET is the Asterisk Manager Interface user's password.
# ALERT_UUID is any random UUID you choose yourself (e.g. `uuidgen`) - it's
# how the service tells an inbound call from an outbound alert call it
# placed itself. Must match what's in your Asterisk dialplan
# [claude-phone-alert] context. See asterisk/ASTERISK_SETUP.md.
AMI_SECRET=
ALERT_UUID=

# ---------- Tier 4: Discord notifications (optional) ----------
DISCORD_WEBHOOK=

# ---------- Optional tools ----------
# Only needed if you've filled in the corresponding section in config.yaml.
PIHOLE_APP_PASSWORD=
UNIFI_API_KEY=
